<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Trellis.Assistant</RootNamespace>
    <AssemblyName>Trellis.Assistant</AssemblyName>
    <!-- Phase 2 non-negotiable: warnings fail the build. Catches accidental
         API drift (e.g. obsoleted EF/Npgsql signatures, unused awaits) at
         compile time rather than letting them slip into a deploy. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Always-on personal AI surface for the TerraVerde Trellis system. Voice-first multi-channel presence; MCP-based tool dispatch; cross-surface memory.</Description>
    <Authors>Terraverde Solutions LLC</Authors>
    <Company>Terraverde Solutions LLC</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- appsettings.user.json is operator-local Dev convenience; gitignored.
         Microsoft.NET.Sdk.Web's implicit auto-include for appsettings*.json
         classifies the file as <Content> with CopyToOutputDirectory=PreserveNewest,
         so it rides into `dotnet publish`'s output by default and onto the
         deployed host. On 2026-05-02 a developer's local Postgres connection
         string leaked onto GB10 via this exact path during the trainer-qa
         bootstrap. The canonical fix landed in trellis-trainer PR #41,
         trellis-web PR #14, and trellis-server PR #56; Assistant's csproj
         carries it from day one so Phase 0 doesn't repeat the bootstrap-day
         appsettings leak.

         Two Remove rules — defense in depth. The SDK uses <Content>; the
         <Content Remove> line is the load-bearing one. The <None Remove>
         line covers the variant where a future SDK change (or another
         project tweaking these implicit-include semantics) reclassifies
         the file as <None>. Either rule is silent if its target item type
         doesn't carry the file; together they guarantee the file is gone
         from publish output regardless of which item-type the SDK uses.

         Pinned by Trellis.Assistant.Tests/DotnetPublishTests, which
         actually invokes `dotnet publish` against this project + asserts
         the file is absent from the output dir. An XML-only test would
         false-green: trainer #41's broken <None Update> form passed XML
         inspection but still leaked, because the SDK classifies the file
         as <Content> not <None>. -->
    <None Remove="appsettings.user.json" />
    <Content Remove="appsettings.user.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 10 + Npgsql provider. Same versions as trellis-trainer's
         csproj (10.0.1) for consistent migration tooling across the QA
         fleet. Microsoft.EntityFrameworkCore.Design is build-only (the
         design-time EF tooling for `dotnet ef migrations add`); marked
         PrivateAssets=all so it doesn't transitively flow to consumers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />

    <!-- Macro 3 PR 2: JWT bearer validation. Microsoft.AspNetCore.Authentication.JwtBearer
         carries the OIDC discovery + signing-key resolution + token validation surface
         that AddJwtBearer wires up. Latest stable for net10.0; pin major version to keep
         OpenID Connect metadata format compatible with the Auth-side issuer. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />

    <!-- Ulid for time-sortable conversation/turn IDs. The .NET-domain type
         is `Ulid`; we convert to/from `Guid` at the EF boundary so the
         Postgres column stays the native `uuid` type. The byte layout
         survives the conversion, so the time-sortable property holds in
         the DB index. Trellis.Core stays Ulid-free; the interface speaks
         Guid (see Trellis.Core/Services/IAssistantConversationStore.cs). -->
    <PackageReference Include="Ulid" Version="1.3.4" />
  </ItemGroup>

  <!-- Trellis.Core lives in a sibling repo at ..\..\core\. Local builds
       assume that layout (per trellis-docs/MarkdownFiles/56-project-structure.md). -->
  <ItemGroup>
    <ProjectReference Include="..\..\core\Trellis.Core\Trellis.Core.csproj" />
  </ItemGroup>

</Project>
